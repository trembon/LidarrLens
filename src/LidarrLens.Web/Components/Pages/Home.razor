@page "/"
@inject IScanService Scans
@inject ILidarrLensStore Store
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Dashboard · LidarrLens</PageTitle>
<div class="page-head"><div><p class="eyebrow">Library audit</p><h1>Improve your library, one careful edit at a time.</h1><p class="lede">LidarrLens compares Lidarr’s inventory with MusicBrainz and Deezer, then turns the gaps into a copy-ready queue.</p></div><button class="primary" @onclick="StartScan" disabled="@busy">@(busy ? "Scanning…" : "Start scan")</button></div>
@if (!string.IsNullOrWhiteSpace(message)) { <div class="notice">@message</div> }
<div class="stats">
    <div class="stat"><span>Open findings</span><strong>@openCount</strong></div>
    <div class="stat"><span>Resolved</span><strong>@resolvedCount</strong></div>
    <div class="stat"><span>Last scan</span><strong>@(lastScan?.CompletedAt?.ToLocalTime().ToString("g") ?? "Never")</strong></div>
</div>
<section class="panel"><div class="panel-head"><div><p class="eyebrow">Next action</p><h2>Review the queue</h2></div><a class="button" href="/queue">Open work queue</a></div><p>Start with high-confidence missing release groups, then use the evidence view to verify editions before contributing anything to MusicBrainz.</p></section>

@code {
    private bool busy; private string? message; private int openCount; private int resolvedCount; private ScanRun? lastScan;
    protected override async Task OnInitializedAsync() { var findings = await Scans.GetFindingsAsync(null, null, CancellationToken.None); openCount = findings.Count(x => x.Status is not FindingStatus.Resolved and not FindingStatus.Ignored); resolvedCount = findings.Count(x => x.Status == FindingStatus.Resolved); lastScan = (await Store.GetScansAsync(CancellationToken.None)).FirstOrDefault(); }
    private async Task StartScan() { busy = true; message = null; try { var scan = await Scans.StartAsync(CancellationToken.None); message = $"Scan {scan.Status}. Created {scan.FindingsCreated} finding(s)."; lastScan = scan; var findings = await Scans.GetFindingsAsync(null, null, CancellationToken.None); openCount = findings.Count(x => x.Status is not FindingStatus.Resolved and not FindingStatus.Ignored); resolvedCount = findings.Count(x => x.Status == FindingStatus.Resolved); } catch (Exception ex) { message = ex.Message; } finally { busy = false; } }
}
