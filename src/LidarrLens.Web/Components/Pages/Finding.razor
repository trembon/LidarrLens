@page "/findings/{Id}"
@inject IScanService Scans
@inject IJSRuntime Js
@rendermode InteractiveServer

<PageTitle>Finding · LidarrLens</PageTitle>
@if (finding is null)
{
    <p>Loading…</p>
}
else
{
    <a href="/queue">← Back to queue</a>
    <div class="page-head compact">
        <div>
            <p class="eyebrow">@finding.Type · @finding.Confidence confidence</p>
            <h1>@(finding.CopyReady?.Title ?? finding.Type.ToString())</h1>
            <p class="lede">@finding.ArtistName · @finding.SourceName · <span class="badge @finding.Status.ToString().ToLowerInvariant()">@finding.Status</span></p>
        </div>
        <div class="queue-actions">
            @if (finding.Status == FindingStatus.Waiting)
            {
                <button @onclick="() => SetStatus(FindingStatus.Pending)">Return to pending</button>
            }
            else
            {
                <button @onclick="() => SetStatus(FindingStatus.Waiting)">Mark waiting</button>
            }
        </div>
    </div>
    <div class="detail-grid">
        <section class="panel">
            <h2>Suggested action</h2>
            <p>@finding.SuggestedAction</p>
            <h2>MusicBrainz shortcuts</h2>
            <div class="link-list">
                @foreach (var link in MusicBrainzLinkBuilder.Build(finding))
                {
                    <a href="@link.Url" target="_blank" rel="noopener noreferrer">@link.Label</a>
                }
            </div>
            <h2>Evidence</h2>
            <ul>
                @foreach (var item in finding.Evidence)
                {
                    <li>@item</li>
                }
            </ul>
            @if (finding.SourceUrl is not null)
            {
                <p><a href="@finding.SourceUrl" target="_blank" rel="noopener noreferrer">Open source evidence</a></p>
            }
        </section>
        <section class="panel copy-panel">
            <h2>Copy-ready data</h2>
            @if (finding.CopyReady is null)
            {
                <p>No release payload was generated.</p>
            }
            else
            {
                <CopyField Label="Release title" Value="@finding.CopyReady.Title" />
                <CopyField Label="Release group type" Value="@finding.CopyReady.ReleaseGroupType" />
                <CopyField Label="Release date" Value="@finding.CopyReady.ReleaseDate" />
                <CopyField Label="Country" Value="@finding.CopyReady.Country" />
                <CopyField Label="Label" Value="@finding.CopyReady.Label" />
                <CopyField Label="Catalog number" Value="@finding.CopyReady.CatalogNumber" />
                <CopyField Label="Barcode" Value="@finding.CopyReady.Barcode" />
                <CopyField Label="Format" Value="@finding.CopyReady.Format" />
                <CopyField Label="Artwork URL" Value="@finding.CopyReady.ArtworkUrl" />
                @if (!string.IsNullOrWhiteSpace(finding.CopyReady.ArtworkUrl))
                {
                    <p><a href="@finding.CopyReady.ArtworkUrl" target="_blank" rel="noopener noreferrer">Open artwork</a></p>
                    <p class="field-note">Download and inspect this image, then upload it manually through the matching MusicBrainz release’s Cover Art tab.</p>
                }
                <CopyField Label="Tracklist" Value="@string.Join("\n", finding.CopyReady.Tracklist)" />
                <CopyField Label="Edit note" Value="@finding.CopyReady.EditNote" />
                <button class="primary full" @onclick="CopyAll">Copy all release data</button>
            }
        </section>
    </div>
}

@code {
    [Parameter] public string Id { get; set; } = "";
    private AuditFinding? finding;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load() => finding = (await Scans.GetFindingsAsync(null, null, CancellationToken.None)).FirstOrDefault(x => x.Id == Id);

    private async Task SetStatus(FindingStatus status)
    {
        if (finding is null) return;
        await Scans.UpdateStatusAsync(finding.Id, status, CancellationToken.None);
        await Load();
    }

    private async Task CopyAll()
    {
        if (finding?.CopyReady is null) return;
        await Js.InvokeVoidAsync("navigator.clipboard.writeText", CopyReadyTextFormatter.Format(finding.CopyReady));
    }
}
