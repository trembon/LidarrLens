@page "/findings/{Id}"
@inject IScanService Scans
@inject IJSRuntime Js
@rendermode InteractiveServer

<PageTitle>Finding · LidarrLens</PageTitle>
@if (finding is null) { <p>Loading…</p> } else { <a href="/queue">← Back to queue</a><div class="page-head compact"><div><p class="eyebrow">@finding.Type · @finding.Confidence confidence</p><h1>@(finding.CopyReady?.Title ?? finding.Type.ToString())</h1><p class="lede">@finding.ArtistName · @finding.SourceName · <span class="badge">@finding.Status</span></p></div></div><div class="detail-grid"><section class="panel"><h2>Suggested action</h2><p>@finding.SuggestedAction</p><h2>Evidence</h2><ul>@foreach (var item in finding.Evidence) { <li>@item</li> }</ul><h2>Existing MusicBrainz entities</h2><ul>@foreach (var item in finding.ExistingMusicBrainzEntities) { <li><a href="@item" target="_blank">@item</a></li> }</ul>@if (finding.SourceUrl is not null) { <p><a href="@finding.SourceUrl" target="_blank">Open source evidence</a></p> }</section><section class="panel copy-panel"><h2>Copy-ready data</h2>@if (finding.CopyReady is null) { <p>No release payload was generated.</p> } else { <CopyField Label="Release title" Value="@finding.CopyReady.Title" /><CopyField Label="Release group type" Value="@finding.CopyReady.ReleaseGroupType" /><CopyField Label="Release date" Value="@finding.CopyReady.ReleaseDate" /><CopyField Label="Country" Value="@finding.CopyReady.Country" /><CopyField Label="Label" Value="@finding.CopyReady.Label" /><CopyField Label="Catalog number" Value="@finding.CopyReady.CatalogNumber" /><CopyField Label="Barcode" Value="@finding.CopyReady.Barcode" /><CopyField Label="Format" Value="@finding.CopyReady.Format" /><CopyField Label="Tracklist" Value="@string.Join("\n", finding.CopyReady.Tracklist)" /><CopyField Label="Edit note" Value="@finding.CopyReady.EditNote" /><button class="primary full" @onclick="CopyAll">Copy all release data</button> }</section></div> }

@code { [Parameter] public string Id { get; set; } = ""; private AuditFinding? finding; protected override async Task OnInitializedAsync() => finding = (await Scans.GetFindingsAsync(null, null, CancellationToken.None)).FirstOrDefault(x => x.Id == Id); private async Task CopyAll() { if (finding?.CopyReady is null) return; var c = finding.CopyReady; await Js.InvokeVoidAsync("navigator.clipboard.writeText", $"Release title: {c.Title}\nType: {c.ReleaseGroupType}\nDate: {c.ReleaseDate}\nCountry: {c.Country}\nLabel: {c.Label}\nCatalog number: {c.CatalogNumber}\nBarcode: {c.Barcode}\nFormat: {c.Format}\n\n{string.Join("\n", c.Tracklist)}\n\nEdit note: {c.EditNote}"); } }
