LIDARR_URL=http://lidarr:8686
LIDARR_API_KEY=replace-me
MUSICBRAINZ_USER_AGENT=LidarrLens/0.1.0 (contact@example.com)
# Optional. high-level checks release groups only; set to detailed to inspect tracks and editions.
MUSICBRAINZ_SCAN_MODE=high-level
# Optional. iframe (default) embeds MusicBrainz on finding pages; external opens it in a separate tab.
MUSICBRAINZ_TASK_VIEW=iframe
DATA_DIRECTORY=/data
ASPNETCORE_URLS=http://+:8080
# Optional. 0 or unset disables scheduled scans.
SCAN_INTERVAL_MINUTES=0
